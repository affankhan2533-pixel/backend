# ==================================================
# GOR MENSWEAR BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ==================================================

# ── MongoDB Atlas ──────────────────────────────────
# Required. Must be a mongodb+srv:// Atlas URI.
# Database name must be: gormenswear
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gormenswear?retryWrites=true&w=majority

# ── Express Server Port ────────────────────────────
PORT=5000

# ── CORS Allowed Origins ───────────────────────────
# Development:
#   CORS_ORIGIN=http://localhost:3000
#
# Production (comma-separated if multiple domains):
#   CORS_ORIGIN=https://gormenswear.com,https://www.gormenswear.com
#
# If deploying to Vercel, set this to your production frontend URL.
CORS_ORIGIN=http://localhost:3000

# ── Environment Mode ───────────────────────────────
NODE_ENV=development
